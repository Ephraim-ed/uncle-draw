# Copy to .env.local and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Optional: the app's public address. Vercel production builds fill this in
# from the project's production domain; set it to override.
# VITE_SITE_URL=https://uncle-draw.vercel.app

# Optional: STUN/TURN servers for voice chat, as a JSON array of RTCIceServer.
# The default (public STUN) connects most people; add a TURN server for
# networks that block peer-to-peer audio.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]

# Optional: show magic-link email sign-in next to GitHub. Off by default; turn
# it on for local Supabase, where GitHub sign-in is off.
# VITE_EMAIL_SIGN_IN=true
