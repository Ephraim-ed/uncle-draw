{
  "name": "uncle-draw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:mcp",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "node node_modules/typescript-native/bin/tsc -b",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:mcp": "node scripts/check-mcp-bundle.mjs",
    "gen:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/assistant": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.2",
    "idb-keyval": "6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "roughjs": "4.6.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.4",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.4",
    "vitest-canvas-mock": "1.2.0"
  }
}
